{
  "expo": {
    "name": "Pavurio",
    "slug": "pavurio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pavurio.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Take a photo of a vet document or a moment with your pet.",
        "NSPhotoLibraryUsageDescription": "Attach photos to records and moments.",
        "NSPhotoLibraryAddUsageDescription": "Save your pet's stories and Memory Cards to Photos.",
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pavurio.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#14B8C4",
          "defaultChannel": "care-reminders",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to records and moments.",
          "cameraPermission": "Take a photo of a vet document or a moment with your pet.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Attach photos to records and moments.",
          "savePhotosPermission": "Save your pet's stories and Memory Cards to Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-document-picker",
      [
        "expo-widgets",
        {
          "enableAndroid": true
        }
      ],
      "expo-background-task"
    ],
    "scheme": "pavurio",
    "backgroundColor": "#FFFFFF",
    "experiments": {
      "typedRoutes": false
    },
    "locales": {
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "nl": "./locales/nl.json",
      "pl": "./locales/pl.json",
      "ru": "./locales/ru.json",
      "uk": "./locales/uk.json",
      "tr": "./locales/tr.json",
      "ar": "./locales/ar.json",
      "he": "./locales/he.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "hi": "./locales/hi.json",
      "id": "./locales/id.json",
      "ms": "./locales/ms.json",
      "vi": "./locales/vi.json",
      "th": "./locales/th.json",
      "sv": "./locales/sv.json",
      "da": "./locales/da.json",
      "nb": "./locales/nb.json",
      "fi": "./locales/fi.json",
      "cs": "./locales/cs.json",
      "ro": "./locales/ro.json",
      "el": "./locales/el.json",
      "hu": "./locales/hu.json"
    },
    "extra": {
      "eas": {
        "projectId": "f0a29bcf-cf86-4afc-af43-1884388bbda9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "theroadroller",
    "updates": {
      "url": "https://u.expo.dev/f0a29bcf-cf86-4afc-af43-1884388bbda9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
