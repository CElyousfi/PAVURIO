# Copy to functions/.env and fill in. The Resend API key is a secret:
#   npx firebase-tools functions:secrets:set RESEND_API_KEY
MAIL_FROM="Pavurio <hello@pavurio.com>"
# optional: Resend segment that newsletter opt-ins are added to
RESEND_SEGMENT_ID="eb08ac11-4ac2-41a0-9d75-0bb500119a0c"
# reject function calls that lack a valid App Check token (set true after store builds ship)
ENFORCE_APP_CHECK=false
